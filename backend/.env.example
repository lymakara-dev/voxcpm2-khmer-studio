MODEL_ID=sumnim/VoxCPM2-Khmer
LAZY_LOAD=0
MAX_TEXT_CHARS=2000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Skip loading the real model; synthesize a sine-wave clip instead.
# Use for frontend dev without a GPU, CI, and the test suite.
MOCK_TTS=0

# Reference-audio upload (POST /api/upload-ref)
UPLOAD_DIR=/tmp/voxcpm-refs
UPLOAD_MAX_MB=20
UPLOAD_MAX_DURATION_S=60
UPLOAD_TTL_HOURS=24
# Off by default — enabling lets clients pass raw server file paths
# (reference_wav_path/prompt_wav_path) instead of an uploaded ref_id.
# Only enable on trusted, single-user deployments.
ALLOW_RAW_PATHS=0

# Job queue (POST /api/tts, GET /api/jobs/{id})
MAX_QUEUE=10
JOB_TTL_MIN=15

# Auth + rate limiting. Empty (default) disables auth entirely — every route
# except /api/health and /api/model-info stays open. Set a comma-separated
# list to require Authorization: Bearer <key> or X-API-Key on them.
API_KEYS=
# Sliding-window limits, per API key (or per client IP when auth is off).
RATE_LIMIT_PER_MIN=10
RATE_LIMIT_CHARS_PER_HOUR=20000
